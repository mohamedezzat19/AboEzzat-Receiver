<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exo_controller"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#B8000000"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="5dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                app:bar_height="3dp"
                app:scrubber_enabled_size="12dp"
                app:scrubber_dragged_size="16dp"
                app:played_color="#FF55B8FF"
                app:buffered_color="#88FFFFFF"
                app:unplayed_color="#55FFFFFF" />

            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:gravity="end"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/exo_prev"
                android:layout_width="38dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="العنصر السابق"
                android:padding="9dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/exo_rew"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="ترجيع"
                android:padding="9dp"
                android:src="@android:drawable/ic_media_rew"
                android:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/exo_play_pause"
                android:layout_width="48dp"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:contentDescription="تشغيل أو إيقاف مؤقت"
                android:padding="9dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/exo_ffwd"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="تقديم"
                android:padding="9dp"
                android:src="@android:drawable/ic_media_ff"
                android:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/exo_next"
                android:layout_width="38dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="العنصر التالي"
                android:padding="9dp"
                android:src="@android:drawable/ic_media_next"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/abo_player_subtitle"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:contentDescription="البحث عن ترجمة عربية"
                android:focusable="true"
                android:gravity="center"
                android:text="CC"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/abo_player_download"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:contentDescription="تنزيل الوسائط الحالية"
                android:focusable="true"
                android:gravity="center"
                android:text="⬇"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/abo_player_settings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:contentDescription="إعدادات المشغل"
                android:focusable="true"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
