<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exo_controller"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layoutDirection="ltr"
    android:background="#B8000000"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="ltr">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layoutDirection="ltr">

            <TextView
                android:id="@+id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                app:bar_height="3dp"
                app:scrubber_enabled_size="14dp"
                app:scrubber_dragged_size="20dp"
                app:scrubber_color="#FF72C8FF"
                app:played_color="#FF55B8FF"
                app:buffered_color="#88FFFFFF"
                app:unplayed_color="#55FFFFFF" />

            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:gravity="end"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Playback controls stay grouped toward the center/left. -->
        <!-- Utility controls stay anchored to the physical right in every locale. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layoutDirection="ltr">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:layoutDirection="ltr">

                <ImageButton
                    android:id="@+id/exo_prev"
                    android:layout_width="40dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/player_control_focus"
                    android:contentDescription="العنصر السابق"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/exo_rew"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/player_control_focus"
                    android:contentDescription="ترجيع للخلف"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_media_rew"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/exo_play_pause"
                    android:layout_width="50dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/player_control_focus"
                    android:contentDescription="تشغيل أو إيقاف مؤقت"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/exo_ffwd"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/player_control_focus"
                    android:contentDescription="تقديم للأمام"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_media_ff"
                    android:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/exo_next"
                    android:layout_width="40dp"
                    android:layout_height="44dp"
                    android:background="@drawable/player_control_focus"
                    android:contentDescription="العنصر التالي"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layoutDirection="ltr">

                <TextView
                    android:id="@+id/abo_player_repeat"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:contentDescription="تكرار التشغيل: متوقف"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="↻"
                    android:textColor="#FFFFFFFF"
                    android:textSize="23sp" 
                    android:background="@drawable/player_control_focus"/>

                <ImageButton
                    android:id="@+id/abo_player_download"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/player_control_focus"
                    android:contentDescription="تنزيل الوسائط الحالية"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_download_modern"
                    android:tint="#FFFFFFFF"/>

                <TextView
                    android:id="@+id/abo_player_subtitle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:contentDescription="البحث عن ترجمة عربية"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="CC"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" 
                    android:background="@drawable/player_control_focus"/>

                <TextView
                    android:id="@+id/abo_player_settings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:contentDescription="إعدادات المشغل"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="#FFFFFFFF"
                    android:textSize="21sp" 
                    android:background="@drawable/player_control_focus"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
